# AWS Bedrock Configuration
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
ROUTER_MODE=llm

# Google Custom Search JSON API Configuration
# Optional: Set these to enable live dynamic search via Google CSE API.
# If not set, system automatically falls back to DuckDuckGo search and seed portals.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Storage & Scraper Configuration
USE_LOCAL_STUBS=1
SCRAPER_MODE=fixture

# MERaLiON Speech-to-Text API Configuration
# Required for speech-to-text transcription via MERaLiON API
MERALION_API_KEY=
MERALION_BASE_URL=https://api.meralion.ai/v1
MERALION_MODEL=MERaLiON/MERaLiON-3-10B
MERALION_TIMEOUT=60
